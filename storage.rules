rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for images
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
