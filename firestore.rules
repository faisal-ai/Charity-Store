rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only collections (website content)
    match /images/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /mentors/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Booking collections: anyone can submit (create), but cannot read or delete others' bookings
    match /donation_bookings/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /mentoring_bookings/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
